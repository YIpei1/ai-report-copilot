{
    "name": "ai-report-copilot",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.14.0 <23",
        "pnpm": ">=10.6.5 <11"
    },
    "scripts": {
        "verify": "pnpm format:check && pnpm lint && pnpm lint:style && pnpm build",
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "prepare": "husky",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --max-warnings=0",
        "lint:style:fix": "stylelint \"src/**/*.{css,scss,vue}\" --fix"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts}": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "prettier --write"
        ],
        "*.vue": [
            "eslint --fix --max-warnings=0 --no-warn-ignored",
            "stylelint --fix --max-warnings=0",
            "prettier --write"
        ],
        "*.{css,scss}": [
            "stylelint --fix --max-warnings=0",
            "prettier --write"
        ],
        "*.{json,md,html,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@element-plus/icons-vue": "^2.3.2",
        "@fingerprintjs/fingerprintjs": "^5.2.0",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.18.1",
        "element-plus": "^2.14.3",
        "pinia": "^4.0.2",
        "pinia-plugin-persistedstate": "^4.7.1",
        "vue": "^3.5.39",
        "vue-draggable-plus": "^0.6.1",
        "vue-router": "^5.2.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.13.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.1.1",
        "msw": "^2.15.0",
        "postcss-html": "^1.8.1",
        "postcss-scss": "^4.0.9",
        "prettier": "^3.9.6",
        "sass": "^1.101.6",
        "stylelint": "^17.14.1",
        "stylelint-config-recommended-vue": "^1.6.1",
        "stylelint-config-standard-scss": "^17.0.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.65.0",
        "unplugin-auto-import": "^21.0.0",
        "unplugin-vue-components": "^32.1.0",
        "vite": "^8.1.1",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vite-plugin-vue-setup-extend": "^0.4.0",
        "vue-tsc": "^3.3.5"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    }
}
